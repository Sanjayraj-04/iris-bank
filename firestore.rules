rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
    }

    // User role records: customers may create only their own CUSTOMER profile.
    // The first ADMIN profile must be provisioned manually in Firebase Console.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'CUSTOMER';
      allow update: if isAdmin() && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    // Customer-submitted applications; only admins may review/change status.
    match /customer_applications/{applicationId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'PENDING'
        && request.resource.data.kyc.status == 'PENDING'
        && request.resource.data.accountRequest.initialDepositMinor == 100000;
      allow read: if signedIn()
        && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Private banking data remains server-controlled. Never open these to clients.
    match /accounts/{id} { allow read, write: if false; }
    match /ledger_entries/{id} { allow read, write: if false; }

    // Other collections remain closed until their ownership and workflows are implemented.
    match /{document=**} { allow read, write: if false; }
  }
}
